<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Hands a shared Recap slide to the app the user picks. Only the recap-share cache folder is exposed. -->
        <provider
            android:name=".RecapShareProvider"
            android:authorities="${applicationId}.recap"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/recap_share_paths" />
        </provider>
    </application>
</manifest>
